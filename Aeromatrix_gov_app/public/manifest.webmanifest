{
  "id": "/",
  "name": "AeroMatrix Commissioner",
  "short_name": "AeroMatrix",
  "description": "Decision support for the Municipal Commissioner of Pune and Pimpri-Chinchwad: find the air-quality problem, explain it, test an action and get a costed plan.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#fbf6ec",
  "theme_color": "#a3263f",
  "categories": ["utilities", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pwa/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Alerts", "short_name": "Alerts", "description": "Open the alerts", "url": "/#alerts", "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Simulator", "short_name": "Simulator", "description": "Test an action", "url": "/#simulator", "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Reports", "short_name": "Reports", "description": "Prepare a report", "url": "/#reports", "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
