# AeroSage (chatbot) settings. Copy to .env to use. Every value is optional.

# Where the trained model API runs (read-only GET calls only).
AEROMATRIX_API_URL=http://127.0.0.1:8000

# Optional: lets AeroSage explain concepts, answer general questions and translate.
# Without it station numbers and project notes still work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Port, and the web origins allowed to call it (comma separated). Leave the origins blank for the local defaults.
CHATBOT_PORT=8010
CHATBOT_ALLOWED_ORIGINS=
