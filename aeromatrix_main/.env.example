# Optional Cesium ion token. Enables the photorealistic 3D city layer (Google Photorealistic 3D Tiles via ion + World Terrain).
VITE_CESIUM_ION_TOKEN=
# Optional Google Maps Platform key (Map Tiles API) as an alternative source for the photorealistic layer.
VITE_GOOGLE_MAPS_API_KEY=
# Address of the trained model service (FastAPI). Default http://127.0.0.1:8000
VITE_AEROMATRIX_API_URL=
# Optional grid-forecast service (there is no legacy backend in this repository). Default http://localhost:8000
VITE_API_URL=
# Target of the "Back to site" link in the header. Default http://localhost:3000/
VITE_LANDING_URL=
# Minutes between live Open-Meteo refreshes. Minimum 5, default 60.
VITE_LIVE_REFRESH_MINUTES=60
