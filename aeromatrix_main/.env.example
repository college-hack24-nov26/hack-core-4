# Optional Cesium ion token. Enables the photorealistic 3D city layer (Google Photorealistic 3D Tiles via ion + World Terrain).
VITE_CESIUM_ION_TOKEN=
# Optional Google Maps Platform key (Map Tiles API) as an alternative source for the photorealistic layer.
VITE_GOOGLE_MAPS_API_KEY=
# Minutes between live data refreshes (used from V3).
VITE_LIVE_REFRESH_MINUTES=60
